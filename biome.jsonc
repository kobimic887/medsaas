{
  // Lint-only gate; brownfield relaxes ratchet to error over time. See docs/IMPROVEMENTS.md item 3.
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "server/**/*.{js,mjs,jsx}",
      "client/src/**/*.{js,mjs,jsx}",
      "scripts/**/*.{js,mjs}",
      "!**/dist/**",
      "!**/node_modules/**"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "css": {
    "linter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedFunctionParameters": "warn",
        "useExhaustiveDependencies": "off",
        "useParseIntRadix": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noGlobalIsNan": "error",
        "noPrototypeBuiltins": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      },
      "style": {
        "useTemplate": "off",
        "useNodejsImportProtocol": "off",
        "useExponentiationOperator": "off"
      },
      "complexity": {
        "useOptionalChain": "off",
        "useLiteralKeys": "off",
        "useArrowFunction": "off"
      },
      "a11y": {
        "useKeyWithClickEvents": "warn",
        "noLabelWithoutControl": "warn",
        "noSvgWithoutTitle": "error",
        "useButtonType": "error",
        "useValidAnchor": "warn",
        "noStaticElementInteractions": "warn",
        "useSemanticElements": "warn",
        "useAriaPropsSupportedByRole": "error",
        "useAltText": "error"
      }
    }
  }
}
