{
  "name": "medsaas-api",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "bun index.js",
    "dev": "bun --watch index.js",
    "start:unified": "FRONTEND_DIST=../client/dist bun index.js",
    "start:bun": "bun index.js",
    "dev:bun": "bun --watch index.js",
    "start:unified:bun": "FRONTEND_DIST=../client/dist bun index.js",
    "start:node": "node index.js",
    "dev:node": "node --watch index.js",
    "start:unified:node": "FRONTEND_DIST=../client/dist node index.js",
    "import:mol-price": "node import-mol-price.js",
    "test:stripe": "SERVER_RUNTIME=bun bun test/stripe-webhook.test.mjs",
    "test:stripe:bun": "SERVER_RUNTIME=bun bun test/stripe-webhook.test.mjs",
    "test:stripe:node": "node test/stripe-webhook.test.mjs",
    "test:branding": "SERVER_RUNTIME=bun bun test/branding.test.mjs",
    "test:branding:bun": "SERVER_RUNTIME=bun bun test/branding.test.mjs",
    "test:branding:node": "SERVER_RUNTIME=node node test/branding.test.mjs",
    "test:runtime-smoke": "node test/runtime-smoke.test.mjs",
    "test:runtime-watch": "node test/runtime-watch-smoke.mjs",
    "test:email-theming": "SERVER_RUNTIME=bun bun test/email-theming.test.mjs",
    "test:email-theming:bun": "SERVER_RUNTIME=bun bun test/email-theming.test.mjs",
    "test:email-theming:node": "SERVER_RUNTIME=node node test/email-theming.test.mjs",
    "test:asinex": "SERVER_RUNTIME=bun bun test/asinex-compound.test.mjs",
    "test:asinex:bun": "SERVER_RUNTIME=bun bun test/asinex-compound.test.mjs",
    "test:asinex:node": "SERVER_RUNTIME=node node test/asinex-compound.test.mjs",
    "test:ssrf": "SERVER_RUNTIME=bun bun test/ssrf-ligand-config.test.mjs",
    "test:ssrf:bun": "SERVER_RUNTIME=bun bun test/ssrf-ligand-config.test.mjs",
    "test:ssrf:node": "SERVER_RUNTIME=node node test/ssrf-ligand-config.test.mjs",
    "test": "bun run test:asinex:bun && bun run test:email-theming:bun && bun run test:stripe:bun && bun run test:branding:bun && bun run test:ssrf:bun && bun run test:runtime-smoke",
    "test:node": "npm run test:asinex:node && npm run test:email-theming:node && npm run test:stripe:node && npm run test:branding:node && npm run test:ssrf:node && SERVER_RUNTIME=node node test/runtime-smoke.test.mjs"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "amqplib": "^0.10.9",
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^4.22.2",
    "form-data": "^4.0.6",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.17.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.11",
    "sharp": "0.34.5",
    "stripe": "^22.2.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0"
  },
  "overrides": {
    "jws": "3.2.3",
    "path-to-regexp": "0.1.13"
  }
}
