-// --- Wrappers for http://151.145.91.17:8000/docs ---
+// ── Simulation credits ───────────────────────────────────────────────────────
+// Two bugs lived here. The balance was read and then written in two separate
+// operations, so two concurrent requests on one remaining credit both passed the
+// read and drove the balance negative. And the credit was taken BEFORE the
+// docking call with no way back, so every Asinex outage billed users for docks
+// that never ran — the exact failure the new box exists to remove.
+//
+// chargeSimulationCredit puts the balance test inside the update filter, so it
+// is atomic. refundSimulationCredit gives it back when the work did not happen.
+async function chargeSimulationCredit(username) {
+  const result = await usersCollection.updateOne(
+    { username, simulationTokens: { $gt: 0 } },
+    { $inc: { simulationTokens: -1 } }
+  );
+  return result.matchedCount === 1;
+}
+
+async function refundSimulationCredit(username, reason) {
+  try {
+    await usersCollection.updateOne({ username }, { $inc: { simulationTokens: 1 } });
+    console.log(`[credits] refunded ${username}: ${reason}`);
+  } catch (e) {
+    // Never let a failed refund replace the upstream error the caller reports.
+    console.error(`[credits] refund FAILED for ${username}: ${e.message}`);
+  }
+}
+
