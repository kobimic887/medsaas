# Rollback frontend (Vite :5173). Not the public site after the 2026-08-23 soft flip.
# `dev-vite-only`, NOT `npm run dev` (that also starts stripe-server.cjs → EADDRINUSE).
# Tree on 84: /root/pyxis-ROLLBACK-frontend-5173.
[Unit]
Description=Pyxis legacy frontend (Vite dev server, port 5173)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/pyxis-ROLLBACK-frontend-5173
ExecStart=/usr/bin/npm run dev-vite-only
Restart=always
RestartSec=5
StandardOutput=append:/var/log/pyxis-vite-legacy.log
StandardError=append:/var/log/pyxis-vite-legacy.log
# Vite's dep-optimizer writes into node_modules/.vite, so the tree cannot be read-only.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
