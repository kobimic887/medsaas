# stripe-server.cjs on :3001. Rollback-only now (public is pyxis-web :5174).
# Stopped on 84 (2026-08-23); unit stays enabled; tree stays.
# Start only if rolling nginx back to :5173 (legacy Vite proxies /api here).
#
# Hardened 2026-07-29: the destination of /api/send-email is server-controlled rather than
# taken from the request body (it was an open relay through the company mailbox), both
# mail routes are rate limited per client IP plus globally, /api/test-email answers only
# to localhost, and the transport reads EMAIL_HOST/EMAIL_PORT instead of hardcoding a
# provider this account does not use.
#
# Redundant while public is pyxis-web. Stopped; do not start unless rolling back.
[Unit]
Description=Pyxis legacy Stripe/contact server (port 3001)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/pyxis-ROLLBACK-frontend-5173
# Secrets live OUTSIDE the webroot. Historical: when this Vite tree was public,
# server.fs.deny replaced Vite defaults and https://app.pyxis-discovery.com/.env
# leaked. Public is pyxis-web :5174 now. Only VITE_* may live in that tree's .env.
EnvironmentFile=/root/pyxis-secrets/stripe-server.env
ExecStart=/usr/bin/node stripe-server.cjs
Restart=always
RestartSec=5
StandardOutput=append:/var/log/pyxis-stripe.log
StandardError=append:/var/log/pyxis-stripe.log
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
