# chem_beo, the legacy API on :3000. It terminates its own TLS and bypasses nginx.
#
# Rollback only. Stopped on 84 (2026-08-23); unit stays enabled; tree stays.
# Do not start unless nginx is rolling public back to :5173. Same Atlas as live.
[Unit]
Description=Pyxis legacy API (chem_beo, port 3000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/pyxis-ROLLBACK-backend-3000
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=5
StandardOutput=append:/var/log/pyxis-api-legacy.log
StandardError=append:/var/log/pyxis-api-legacy.log
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
