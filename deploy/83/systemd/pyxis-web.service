# Public Pyxis on :5174 (soft flip 2026-08-23). systemd + Bun, not Docker.
# nginx :443 / :8443 -> 127.0.0.1:5174. Legacy Vite :5173 is rollback only.
# Tree on 84: /root/pyxis-LIVE-5174 (was pyxis-new-standby-5174).
[Unit]
Description=Pyxis web (this repo's server + client/dist, port 5174 — see header)
After=network-online.target
Wants=network-online.target
# No Conflicts= any more: the two run side by side on different ports. Restore it if
# they are ever both pointed at 5173 again.

[Service]
Type=simple
User=root
WorkingDirectory=/root/pyxis-LIVE-5174/server
Environment=PORT=5174
Environment=FRONTEND_DIST=/root/pyxis-LIVE-5174/client/dist
ExecStart=/usr/local/bin/bun index.js
Restart=always
RestartSec=5
StandardOutput=append:/var/log/pyxis-web.log
StandardError=append:/var/log/pyxis-web.log
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
