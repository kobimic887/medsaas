# Compute configuration template; supply private values through the operator.
# See deploy/box/BRIEF-SERVICES.md and each service README before deployment.
# Keep BIND_ADDR on loopback. Qualify GPU IDs and engine availability explicitly.
# The implemented docking engine is vina; autodock-gpu is an unavailable stub.
# Match the Postgres/RDKit image to the verified database backup format.
# Obtain current dataset counts, service URLs, access and rollback records privately.

BIND_ADDR=127.0.0.1
BOX_DOMAIN=
DOCKING_ENGINE=vina
DIFFDOCK_ENGINE=oss
PG_USER=tanimoto
PG_PASSWORD=
PG_DB=tanimoto
TANIMOTO_IMAGE=tonomitosql:latest
TANIMOTO_DB_IMAGE=informaticsmatters/rdkit-cartridge-debian:Release_2025_03_3
MONGODB_URI=
ADMET_CALLBACK_URL=
ADMET_CALLBACK_SECRET=
