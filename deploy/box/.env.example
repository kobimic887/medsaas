# deploy/box/.env — copy to .env on the box and fill in. NEVER commit the filled copy.
#
#   cp deploy/box/.env.example deploy/box/.env

# ── Exposure ────────────────────────────────────────────────────────────────
# Bind address for every published port. LEAVE THIS ON LOOPBACK. Caddy on :443 is the
# only thing that should reach these, and the host firewall admits only 83 to :443
# (ARRIVAL-RUNBOOK Phase 3.1). 0.0.0.0 puts unauthenticated GPU compute on the public
# internet — that is exactly how the NVIDIA quota was drained through chem_beo's open
# endpoints. There is no VPN in this design and none is needed.
BIND_ADDR=127.0.0.1

# The public hostname Caddy serves and 83 calls, e.g. box.pyxis-discovery.com. It must
# resolve publicly for Let's Encrypt to issue, which is why this is a real name and not
# a private address.
BOX_DOMAIN=

# ── Engine selection ────────────────────────────────────────────────────────
# replay = returns the committed reference payload, no GPU. Use it to test the whole
# pipeline before the cards work. vina = CPU AutoDock Vina. See deploy/box/docking/BRIEF.md §6.
DOCKING_ENGINE=autodock-gpu
DIFFDOCK_ENGINE=oss

# ── Tanimoto ────────────────────────────────────────────────────────────────
# Restored from Oracle's pg_dump — production data, 2,951,975 molecules, the ONLY copy.
# See ARRIVAL-RUNBOOK §4.3.
PG_USER=tanimoto
PG_PASSWORD=
PG_DB=tanimoto
TANIMOTO_IMAGE=tonomitosql:latest
TANIMOTO_DB_IMAGE=informaticsmatters/rdkit-cartridge-debian:latest

# ── ADMET worker ────────────────────────────────────────────────────────────
# Atlas. The box's IP must be on the Atlas network allowlist first, or every connection
# fails with a TLS alert 80.
MONGODB_URI=
# Where the worker PUTs results: https://app.pyxis-discovery.com/api/simulation/{key}/admet
ADMET_CALLBACK_URL=
ADMET_CALLBACK_TOKEN=

# ────────────────────────────────────────────────────────────────────────────
# What the PLATFORM sets, on 83 — not here. Listed so the cutover is in one place.
#
#   chem_beo/.env                    (if the server swap has not shipped)
#     DOCKING_API_URL=http://<box>:8000/docking
#     DIFFDOCK_API_URL=http://<box>:8002/molecular-docking/diffdock/generate
#     SDF_CONVERTER_URL=http://<box>:8001/convertSTR
#     TANIMOTO_API_BASE=http://<box>:8003
#     ASINEX_CATALOG_BASE / STOCK_API_URL  ← LEAVE ON ASINEX. Catalog needs their
#                                             compound file for licensing; live stock
#                                             cannot be self-hosted at any price.
#
#   this repo's server              (if it has)
#     company.ligandServiceConfig — dockingApiUrl, diffdockApiUrl. Set from the admin UI.
#     ⚠ assertConfiguredUrlsArePublic REJECTS private ranges and CGNAT 100.64/10.
#
# One variable at a time, restart, verify, then the next. Rollback is unsetting it.
# Keep the Asinex URLs valid — they are the disaster-recovery path, and the box has a
# 1-3 week repair time (docs/BOX-SPEC.md §3).
