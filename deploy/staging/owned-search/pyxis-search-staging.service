# Combined macrocycle search: similarity (/v1/*) and ID/exact/substructure + stock
# graph (/graph/*) in ONE unit on the existing owned-search port, so the existing
# pyxis-owned-search-tunnel (oracleNew 18276) carries both. Replaced
# pyxis-owned-search-staging + pyxis-owned-macrocycle-search-staging (+ its 18280
# tunnel). SHARED: staging AND production use it (despite the unit name), so a
# restart needs production approval. The old shared :8274 service is rollback only.
# `current` links to an immutable git-archive release (see the staging README).
[Unit]
Description=Pyxis staging combined macrocycle search (scientific host only)
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/.local/share/pyxis/search-releases/current
Environment=BIND_HOST=127.0.0.1
Environment=PORT=8276
Environment=MACROCYCLE_INDEX_DIR=/home/ubuntu/.local/share/pyxis/macrocycle-index-staging
Environment=OWNED_GRAPH_DIR=/home/ubuntu/.local/share/pyxis/owned-search-graph-staging
Environment=OWNED_SEARCH_PYTHON=/usr/bin/python3
# Private 0700 directory for the graph child's Unix socket; removed on stop.
RuntimeDirectory=pyxis-search-staging
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/docker cp services/owned-search/stock_sql.py tonomitosql-api-1:/tmp/pyxis-owned-stock.py
ExecStart=/home/ubuntu/.bun/bin/bun services/owned-search/combined.mjs
Restart=on-failure
RestartSec=5
Nice=10
# Sum of the two units it replaces (80% + 80%, 1500M + 1G).
CPUQuota=160%
MemoryMax=2500M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
