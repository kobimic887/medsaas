# Isolated Pyxis staging on :5274 (see deploy/staging/README.md).
#
# - Loopback ONLY (BIND_HOST=127.0.0.1): nginx `location /staging/` is the only
#   path to this process. Never bind 0.0.0.0.
# - PYXIS_DEMO_MODE=true: no MongoDB, no Stripe, no NVIDIA; fixture results;
#   paid/outbound endpoints refused by the demo router.
# - JWT_SECRET lives in /root/pyxis-STAGING-5274/server/.env (root-owned,
#   mode 600, generated at install). Production and staging use different
#   secrets, so tokens never cross between the environments.
# - NOT enabled: a reboot must NOT resurrect staging. Start manually after each
#   approved staging install/update.
[Unit]
Description=Pyxis staging /staging/ (isolated demo, loopback 5274 — see header)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/pyxis-STAGING-5274/server
Environment=PORT=5274
Environment=BIND_HOST=127.0.0.1
Environment=FRONTEND_DIST=/root/pyxis-STAGING-5274/client/dist
Environment=PYXIS_DEMO_MODE=true
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/bun index.js
Restart=always
RestartSec=2
StandardOutput=append:/var/log/pyxis-web-staging.log
StandardError=append:/var/log/pyxis-web-staging.log
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
