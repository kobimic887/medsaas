[Unit]
Description=Private macrocycle search transport to the staging application
After=network-online.target pyxis-macrocycle-search-staging.service
Wants=network-online.target pyxis-macrocycle-search-staging.service

[Service]
Type=simple
User=ubuntu
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -R 127.0.0.1:18274:127.0.0.1:8274 oracleNew
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
