[Unit]
Description=Pyxis macrocycle similarity index on the scientific data host
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/medsaas
Environment=BIND_HOST=127.0.0.1
Environment=PORT=8274
Environment=MACROCYCLE_INDEX_DIR=/home/ubuntu/.local/share/pyxis/macrocycle-index-staging
ExecStart=/home/ubuntu/.bun/bin/bun services/macrocycle-index/serve.mjs
Restart=on-failure
RestartSec=5
CPUQuota=80%
MemoryMax=1500M
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
