# The worker needs three things and refuses to start without them.
MONGODB_URI=mongodb+srv://user:pass@cluster/dbname
ADMET_CALLBACK_URL=https://app.pyxis-discovery.com
ADMET_CALLBACK_SECRET=replace-with-the-servers-ADMET_CALLBACK_SECRET

# admet-ai | stub. `stub` is deterministic, needs no model, and is what the tests run on.
ADMET_ENGINE=admet-ai

# Optional.
ADMET_POLL_SECONDS=10
ADMET_HEARTBEAT_SECONDS=30
ADMET_STALE_AFTER_SECONDS=900
LOG_LEVEL=INFO
