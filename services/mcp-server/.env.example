# --- ChemBench MCP server configuration ---

# Base URL of the ChemBench platform API this MCP server proxies to.
MEDSAAS_API_BASE=http://localhost:3000

# Streamable HTTP listener (what Claude for Life Sciences connects to).
MCP_HOST=0.0.0.0
MCP_PORT=8080

# Upstream call timeout in milliseconds (MD/docking jobs can be slow).
MCP_REQUEST_TIMEOUT_MS=120000

# Only used by the stdio entrypoint (Claude Desktop / local use). A ChemBench
# platform JWT from POST /api/signin. The HTTP entrypoint ignores this and reads
# the token per-request from the Authorization header instead.
MEDSAAS_TOKEN=
