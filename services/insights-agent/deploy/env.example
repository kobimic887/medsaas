# Copy to ~/.config/pyxis-insights-agent/env and chmod 600. Never commit the real file.
WP_URL=https://www.pyxis-discovery.com
# A WordPress user with the Editor role and an application password
# (WP admin → Users → Profile → Application Passwords).
WP_USER=insights-agent
WP_APP_PASSWORD=
# draft (default): a person reviews and publishes. pending: shows in "Pending review".
# publish: fully automatic, and the post no longer claims a human review.
WP_STATUS=draft
# Insights tag slug: insight, news, publication or event.
WP_TAG=insight
# Optional media library ID used as the card image until an editor sets one.
WP_FEATURED_MEDIA=

# claude-cli uses `claude -p` with this host's Claude login (subscription).
LLM_PROVIDER=claude-cli
LLM_MODEL=sonnet
# Or any OpenAI-compatible endpoint, e.g. OmniRoute or OpenRouter:
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://127.0.0.1:20128/v1
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=anthropic/claude-sonnet-5.5

# Optional: run after each post with (title, message), e.g. kobi-notify.
NOTIFY_CMD=
# Optional NCBI key raises the PubMed rate limit; not needed for a few runs a week.
NCBI_API_KEY=
PUBMED_DAYS=21
