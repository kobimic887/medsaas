# Core server
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Branding. The company name on the account wins; these are fallbacks for the
# logged-out surface and for records with no company. Keep both names in step —
# PLATFORM_NAME is read at runtime by the server, VITE_PLATFORM_NAME is baked
# into the bundle at BUILD time, so changing it needs a rebuild, not a restart.
PLATFORM_NAME=Pyxis Discovery
PLATFORM_WEBSITE_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
# Session token lifetime (jsonwebtoken `expiresIn` format, e.g. 12h, 7d, 30d). Optional; defaults to 7d.
JWT_EXPIRES_IN=7d

# MongoDB
MONGODB_URI=mongodb://localhost:27017/medsaas
# For the containerized deploy (mongo runs as a compose service), use instead:
#   MONGODB_URI=mongodb://root:<MONGO_PASSWORD>@mongo:27017/medsaas?authSource=admin
# and set the mongo container root credentials:
MONGO_USER=root
MONGO_PASSWORD=change-me

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Frontend build-time config
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
VITE_PLATFORM_NAME=Pyxis Discovery
# Leave empty for local dev — Vite proxies /api and other backend paths to port 3000
# VITE_API_BASE_URL=

# Outbound mail (invites, password resets, the public contact form).
#
# EMAIL_HOST is REQUIRED and is not Titan, despite what every comment in this repo used
# to say. Production sends through server028.yourhosting.nl:587; smtp.titan.email rejects
# these credentials with `535 5.7.8 authentication failed` on 465 and 587 alike. Leaving
# EMAIL_HOST unset makes emailService.js fall back and log loudly, and the fallback is a
# guess — set it.
EMAIL_HOST=smtp.example.com
# 465 = implicit TLS, 587/25 = STARTTLS. The port decides which is used.
EMAIL_PORT=587
EMAIL_USER=notifications@example.com
EMAIL_PASS=replace-with-mail-password
# The From: address. Falls back to "PLATFORM_NAME <EMAIL_USER>" if unset.
EMAIL_FROM=notifications@example.com
# Diagnostics only, and never in production: EMAIL_DEBUG=1 prints the whole SMTP
# conversation, AUTH PLAIN line included — which is the base64 of EMAIL_USER and
# EMAIL_PASS. It used to be on unconditionally and wrote the credentials to the log on
# every send.
# EMAIL_DEBUG=1
# Accept any TLS certificate. Only for a host with a genuinely broken chain — it offers
# these credentials to anything that can intercept the connection.
# EMAIL_TLS_INSECURE=1
# Fixed destination for the public contact form (/api/send-email). The endpoint
# never sends to a client-supplied address — it always sends here. Falls back to
# EMAIL_USER if unset.
CONTACT_RECIPIENT=support@example.com

# NVIDIA APIs (hosted NIM — molecule generation and protein folding stay here)
# Single key, still supported:
NVIDIA_MOLMIM_API_KEY=replace-me
NVIDIA_OPENFOLD_API_KEY=replace-me
# Or a comma-separated pool. The server tries keys in order and rotates on 429,
# then backs off, then opens a per-service circuit breaker. Pools are per service —
# MolMIM and OpenFold3 are different endpoints and do not share a quota.
# Do NOT fill these by registering extra NVIDIA accounts to farm free keys: that
# breaks build.nvidia.com's terms and the failure mode is every key revoked at once.
# NVIDIA_MOLMIM_API_KEYS=key-one,key-two
# NVIDIA_OPENFOLD_API_KEYS=key-one,key-two

# External scientific services
TANIMOTO_API_BASE=http://151.145.91.17:8000
# Ligand catalog/stock/docking endpoints. These seed the DEFAULT ligand service
# config; each company can override them in Company Admin (stored on the company record).
ASINEX_API_BASE=http://dev.asinex.com:58181
ASINEX_STOCK_API_URL=https://stock.asinex.com:5443/api/Shop
ASINEX_DOCKING_API_URL=https://services.asinex.com:8000/docking
DIFFDOCK_API_URL=https://services.asinex.com:58000/molecular-docking/diffdock/generate
SDF_CONVERTER_URL=http://83.229.87.94:8001/convertSTR

# RabbitMQ / ADMET worker integration
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
ADMET_QUEUE_NAME=admet_processing_queue
ADMET_CALLBACK_SECRET=replace-with-shared-worker-secret

# Integrated scientific microservices (docker compose --profile science)
GROMACS_API_BASE=http://localhost:8001
GLIOBLASTOMA_API_BASE=http://localhost:5000

# Optional HTTPS serving
# SSL_KEY_PATH=/path/to/key.pem
# SSL_CERT_PATH=/path/to/cert.pem
